# --- Supabase (auth, storage, library) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- TTS: Edge TTS is the default and needs no key ---
# Optional premium / voice cloning fallback (can also be set per-user in Settings)
ELEVENLABS_API_KEY=
# Own-voice (cloning) limits per person, billed to this ElevenLabs account
CLONE_MONTHLY_CHARS=150000
MAX_CLONED_VOICES=5

# --- AI features (summary / notes / translate), optional ---
ANTHROPIC_API_KEY=

# --- Payments ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
YOCO_SECRET_KEY=

# --- Trial reminder emails (Resend) + cron protection ---
RESEND_API_KEY=
EMAIL_FROM=Voxora <hello@voxora.app>
CRON_SECRET=
